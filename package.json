{
    "private": true,
    "name": "spendgate-monorepo",
    "version": "0.1.0",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "packageManager": "npm@11.13.0",
    "scripts": {
        "dev": "turbo run dev --parallel",
        "dev:mobile": "turbo run dev --filter=@spendgate/mobile",
        "dev:web": "turbo run dev --filter=@spendgate/web",
        "dev:investec": "turbo run dev --filter=@spendgate/investec",
        "dev:rules": "turbo run dev --filter=@spendgate/rules",
        "dev:pkg": "turbo run dev --filter=@spendgate/investec --filter=@spendgate/rules",
        "build": "turbo run build",
        "build:api": "turbo run build --filter=@spendgate/api",
        "build:mobile": "turbo run build --filter=@spendgate/mobile",
        "build:web": "turbo run build --filter=@spendgate/web",
        "lint": "turbo run lint",
        "lint:api": "turbo run lint --filter=@spendgate/api",
        "lint:mobile": "turbo run lint --filter=@spendgate/mobile",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run format:check && npm run lint"
    },
    "devDependencies": {
        "@types/node": "^25.6.2",
        "drizzle-kit": "^0.31.10",
        "turbo": "2.9.10"
    }
}
